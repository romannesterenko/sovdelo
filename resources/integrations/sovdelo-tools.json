  {
    "name": "sovdelo_create",
    "description": "Предложить новую задачу в бэклог доступного проекта. Владелец ставит её к выполнению.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "request_key": {
          "type": "string",
          "format": "uuid",
          "description": "Новый UUID на действие. Для повтора используй тот же ключ и тело."
        }
      },
      "required": [
        "title",
        "request_key"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "sovdelo_action",
    "description": "Взять задачу claim, заблокировать block с note, продолжить resume, комментировать comment с note или передать submit с report. Только владелец принимает результат. Это учёт работы: инструмент сам не выполняет код и не запускает фоновое исполнение.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "integer",
          "minimum": 1
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "claim",
            "block",
            "resume",
            "submit",
            "comment"
          ]
        },
        "note": {
          "type": "string"
        },
        "report": {
          "type": "string"
        },
        "request_key": {
          "type": "string",
          "format": "uuid",
          "description": "Новый UUID на действие. Для повтора используй тот же ключ и тело."
        }
      },
      "required": [
        "task_id",
        "expected_version",
        "action",
        "request_key"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "sovdelo_activity",
    "description": "Читать журнал действий проекта, newest first; before_id — предыдущая страница.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "before_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
