  {
    "name": "sovdelo_task",
    "description": "Прочитать задачу и её актуальную version перед изменением.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
